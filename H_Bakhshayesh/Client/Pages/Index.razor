@using System.Globalization;
@inject HttpClient httpClient
@inject NavigationManager navigationManager

@page "/"

@if(baseInformationViewModels != null)
{
    <PageTitle>
        @if (baseInformationViewModels.Where(t => t.Code == "MyName").FirstOrDefault() != null)
        {
            @baseInformationViewModels.Where(t => t.Code == "MyName").FirstOrDefault().Value
        }
        else
        {
            <span>سایت رزومه</span> 
        }
    </PageTitle>

    <div id="about" class="container">
        <div class="bg-white container rounded-4 my-4 py-4">
            <div class="mb-3 mt-2">
                <div>
                    <h2 class="Title-Text">درباره @baseInformationViewModels.Where(t=>t.Code == "MyName").FirstOrDefault().Value</h2>
                </div>
            </div>
            <div id="my-about" class="container rounded-4">
                <div class="w-100 text-center">
                    <img src="/Images/profilePhoto.png" class="img-thumbnail rounded-circle" width="120px" />
                </div>
                <div class="w-100 container my-3">
                    <p>
                        @baseInformationViewModels.Where(t=>t.Code == "AboutMe").FirstOrDefault().Value
                    </p>
                </div>
            </div>
        </div>
    </div>
}
<div id="Skill-Backgrond">
