@code {
    public List<BaseInformationViewModel>? baseInformationViewModels { get; set; };
    public List<DocumentViewModel>? documentViewModels { get; set; }
    public List<ExperienceViewModel>? experienceViewModels { get; set; }
    public List<SkillViewModel>? skillViewModels { get; set; }
}

@functions{
    protected override async Task OnInitializedAsync()
    {
        baseInformationViewModels = await httpClient.GetFromJsonAsync<List<BaseInformationViewModel>>("api/BaseInformation/GetAll");
        documentViewModels = await httpClient.GetFromJsonAsync<List<DocumentViewModel>>("api/Document/GetAll");
        experienceViewModels = await httpClient.GetFromJsonAsync<List<ExperienceViewModel>>("api/Experience/GetAll");
        skillViewModels = await httpClient.GetFromJsonAsync<List<SkillViewModel>>("api/skillView/GetAll");
        await base.OnInitializedAsync();
    }
}