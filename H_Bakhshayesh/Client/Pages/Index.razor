@using System.Globalization;
@inject HttpClient httpClient
@inject NavigationManager navigationManager

@page "/"

@if(baseInformationViewModels != null)
{
    <PageTitle>
        @if (!string.IsNullOrEmpty(MyName))
        {
            @MyName
        }
        else
        {
            <span>سایت رزومه</span> 
        }
    </PageTitle>

    <div id="about" class="container">
        <div id="about-Background" class="bg-white container rounded-4 my-4 py-4">
            <div class="mb-3 mt-2">
                <div>
                    <h2 class="Title-Text">درباره 
                        @if(!string.IsNullOrEmpty(MyName))
                        {
                            @MyName
                        }
                    </h2>
                </div>
            </div>
            <div id="my-about" class="container rounded-4 mt-4">
                <div class="w-100 text-center pb-3">
                    <img src="/Images/profilePhoto.png" class="img-thumbnail rounded-circle" width="120px" />
                </div>
                <div class="w-100 container my-3">
                    <h5 id="about-text" class="text-justify">
                        @if (!string.IsNullOrEmpty(AboutMe))
                        {
                            @((MarkupString)AboutMe)
                        }
                        else
                        {
                            <span class="text-danger">هیچ اطلاعاتی ثبت نشده است.</span>
                        }
                    </h5>
                </div>
            </div>
        </div>
    </div>
}
<div id="Skill-Backgrond">
    <div class="container py-4">
        <div class="mb-3 mt-2">
            <div>
                <h2 class="Title-Text">تخصص‌ها</h2>
            </div>
        </div>
        <div id="skill" class="row  rounded rounded-4 mt-4 px-3">
            @if(skillIds != null && skillIds.Count > 0)
            {
                @foreach (var item in skillIds)
                {
                    <SkillBox id="@item" />
                }
            }
            else
            {
                <div class="alert alert-danger w-100">
                    هنوز تخصصی ثبت نشده است.
                </div>
            }
        </div>
    </div>
</div>

<div id="documents">
    <div class="container ">
        <div class="my-5">
            <div>
                <h2 class="Title-Text">مدارک، تقدیرنامه‌ها و افتخارات</h2>
            </div>
        </div>
        <div id="my-documents" class="row rounded-4 h-100 py-4 my-4">
            @if(documentViewModels != null && documentViewModels.Count > 0)
            {
                @foreach (var item in documentViewModels)
                {
                    <DocumentBox document="@item" />
                }
            }
            else
            {
                <div class="alert alert-danger w-100">
                    هنوز مدرکی ثبت نشده است.
                </div>
            }
        </div>
    </div>
</div>
<div id="experience">
    <div class="container">
        <div class="mb-4 mt-5">
            <div>
                <h2 class="Title-Text">تجربه‌های من</h2>
            </div>
        </div>
        <div id="my-experience" class=" my-4 h-100 py-4 rounded-4 mt-5">
            @if(experienceViewModels != null && experienceViewModels.Count > 0)
            {
                @foreach (var item in experienceViewModels)
                {
                    <ExperienceBox experienceViewModel="@item" />
                }
            }
        </div>
    </div>
</div>

<div id="contacts">
    <div class="container">
        <div class="mb-4 mt-5">
            <div>
                <h2 class="Title-Text">ارتباط با من</h2>
            </div>
        </div>
        <div id="my-contacts" class=" rounded-4 my-4 h-100 py-4 row">
            <div class="col-12 alert alert-success @AddMessageDisplay">
                پیام شما با موفقیت ارسال شد.
                <a  class="me-auto text-dark opacity-50 pointer-event mx-2 " @onclick="@CloseAddAlert">X</a>
            </div>
            <div id="contacts-form" class="col-6 rounded-4 mx-3 mt-4">
                <div class="w-100 text-center my-4">
                    <h4>پیام خودت رو اینجا بنویس !</h4>
                    <p>
                        میتونی برام ایمیل هم بفرستی
                    </p>
                    <p>
                        <i class="fa fa-envelope mx-2"></i>
                        <a id="my-Email" href="#" class="text-black text-decoration-none" title="ارسال ایمیل">
                            @if (!string.IsNullOrEmpty(Email))
                            {
                                @Email
                            }
                        </a>
                    </p>
                </div>
                <div class="w-100 text-center my-2 mb-4">
                    <EditForm Model="@addMessageViewModel" OnValidSubmit="@AddMessage" class="px-3">
                        <div>
                            <span class="text-danger">
                                <DataAnnotationsValidator />
                                <ValidationSummary />
                            </span>
                            <hr />
                        </div>
                        <InputText @bind-Value="@addMessageViewModel.FullName" class="form-control my-4" placeholder="نام و نام خانوادگی..." />
                        <InputText @bind-Value="@addMessageViewModel.Email" class="form-control my-4" placeholder="ایمیل..." />
                        <InputTextArea @bind-Value="@addMessageViewModel.Text" cols="30" rows="10" class="form-control mt-4 p-2 rounded-bottom-0" placeholder="متن پیام..." />
                        <button class="btn btn-success w-100 rounded-bottom-4 rounded-top-0">ارسال پیام</button>
                    </EditForm>
                </div>
            </div>
            <div class="col-5 mx-3">
                <img src="/Images/5124556.jpg" alt="contacts" class="w-100 m-auto">
            </div>
        </div>
    </div>
</div>


@code {
    public List<BaseInformationViewModel>? baseInformationViewModels { get; set; }
    public List<DocumentViewModel>? documentViewModels { get; set; }
    public List<ExperienceViewModel>? experienceViewModels { get; set; }
    public List<Guid>? skillIds { get; set; }
    public MessageViewModel addMessageViewModel = new MessageViewModel();
    public string? MyName;
    public string? AboutMe;
    public string? Email;
    public string? Iam;
    public string AddMessageDisplay = "d-none";
}

@functions{
    protected override async Task OnInitializedAsync()
    {
        baseInformationViewModels = await httpClient.GetFromJsonAsync<List<BaseInformationViewModel>>("api/BaseInformation/GetAll");
        documentViewModels = await httpClient.GetFromJsonAsync<List<DocumentViewModel>>("api/Document/GetAll");
        experienceViewModels = await httpClient.GetFromJsonAsync<List<ExperienceViewModel>>("api/Experience/GetAll");
        skillIds = await httpClient.GetFromJsonAsync<List<Guid>>("api/skill/GetAllIds");
        MyName = baseInformationViewModels.Where(t => t.Code == "MyName").FirstOrDefault().Value;
        AboutMe = baseInformationViewModels.Where(t => t.Code == "AboutMe").FirstOrDefault().Value;
        Email = baseInformationViewModels.Where(t => t.Code == "Email").FirstOrDefault().Value;
        Iam = baseInformationViewModels.Where(t => t.Code == "Iam").FirstOrDefault().Value;
        await base.OnInitializedAsync();
    }

    private async void AddMessage()
    {
        if(addMessageViewModel.Text != null)
        {
            addMessageViewModel.MessageId = Guid.NewGuid();
            addMessageViewModel.CreatedOn = DateTime.Now;
            var res = await httpClient.PostAsJsonAsync<MessageViewModel>("api/Message/Create", addMessageViewModel);
            if(res != null)
            {
                addMessageViewModel = new MessageViewModel();
                AddMessageDisplay = "d-block";
            }
        }
    }

    private void CloseAddAlert()
    {
        AddMessageDisplay = "d-none";
    }
}