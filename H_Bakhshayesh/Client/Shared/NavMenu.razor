@using System.Globalization;
@inject HttpClient httpClient
@inject NavigationManager navigationManager

<div id="navbar-fixed" class="pt-3">
    <div class="navbar-wrapper col-12 d-flex justify-content-center ">
        <nav id="my-Nav" class="navbar col-11 col-md-12 container navbar-expand-lg p-0 rounded-4">
            <div class="container-fluid rounded-4">
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav mb-2 mb-lg-0 py-2">
                        <li class="nav-item">
                            <a class="nav-link mx-1" href="#about">درباره من</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link mx-1" href="#skill">تخصص‌ ها</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link mx-1" href="#documents">مدارک من</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link mx-1" href="#experience">تجربه‌های من</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link mx-1" href="#contacts">ارتباط با من</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </div>
</div>
<div id="Intro" class="row container justify-content-between align-items-center mx-auto">
    <div class="col-5">
        <h1 id="Main-Title">
            @if (!string.IsNullOrEmpty(MyName))
            {
                @MyName
            }
            else
            {
                <span>نام من</span>
            }
        </h1>
        <h3 id="Intro_Text">
            من <span id="Full-Stack">
                @if (!string.IsNullOrEmpty(Iam))
                {
                    @Iam
                }
                else
                {
                    <span>.......</span>
                }

            </span> هستم
        </h3>
    </div>
    <div class="col-5 me-auto">
        <img src="/Images/IMG_2750.png" alt="حسین بخشایش" class="w-100" />
    </div>
</div>

@code {
    public List<BaseInformationViewModel>? baseInformationViewModels { get; set; }
    public string? MyName;
    public string? Iam;
}

@functions {
    protected override async Task OnInitializedAsync()
    {
        baseInformationViewModels = await httpClient.GetFromJsonAsync<List<BaseInformationViewModel>>("api/BaseInformation/GetAll");
        MyName = baseInformationViewModels.Where(t => t.Code == "MyName").FirstOrDefault().Value;
        Iam = baseInformationViewModels.Where(t => t.Code == "Iam").FirstOrDefault().Value;
        await base.OnInitializedAsync();
    }
}